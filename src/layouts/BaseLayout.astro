---
const PUB_ID = "ca-pub-3484572882367046"; // 본인 AdSense 게시자 ID

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canon = Astro.url.href;
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canon} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canon} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="stylesheet"
      as="style"
      crossorigin
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <meta name="google-adsense-account" content={PUB_ID} />
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${PUB_ID}`}
      crossorigin="anonymous"
    ></script>
    <style>
      :root {
        --accent: #ff4d2e;
        --accent-dark: #c93316;
        --sun: #ffc53d;
        --mint: #2fbfa0;
        --bg: #fff6ec;
        --text: #3a2e28;
        --muted: #a08b7a;
        --card: #ffffff;
        --line: #f1e4d4;
        --ink: #3a2e28;
        --shadow: #ecd9bd;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        background-image: radial-gradient(#f3e2c6 1.4px, transparent 1.4px);
        background-size: 22px 22px;
        color: var(--text);
        font-family: "Pretendard Variable", Pretendard, -apple-system,
          "Apple SD Gothic Neo", "Noto Sans KR", sans-serif;
        line-height: 1.7;
        letter-spacing: -0.01em;
      }
      .wrap {
        max-width: 720px;
        margin: 0 auto;
        padding: 0 20px;
      }
      header.site {
        background: #fff;
        border-bottom: 2.5px solid var(--ink);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      header.site .wrap {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 62px;
      }
      .logo {
        font-size: 1.35rem;
        font-weight: 900;
        color: var(--ink);
        text-decoration: none;
        letter-spacing: -0.02em;
      }
      .logo b {
        background: var(--sun);
        border-radius: 8px;
        padding: 0 6px;
      }
      nav.site a {
        margin-left: 6px;
        color: var(--text);
        text-decoration: none;
        font-size: 0.92rem;
        font-weight: 800;
        padding: 6px 12px;
        border-radius: 999px;
      }
      nav.site a:hover {
        background: var(--sun);
        color: var(--ink);
      }
      main {
        padding: 28px 0 60px;
      }
      footer.site {
        background: var(--ink);
        color: #f5e8d8;
        padding: 30px 0 44px;
        font-size: 0.85rem;
      }
      footer.site a {
        color: #f5e8d8;
        text-decoration: none;
        margin-right: 14px;
        font-weight: 700;
      }
      footer.site a:hover {
        color: var(--sun);
      }
      .card {
        background: var(--card);
        border: 2.5px solid var(--ink);
        border-radius: 20px;
        padding: 22px;
        margin: 18px 0;
        box-shadow: 5px 5px 0 var(--shadow);
      }
      .btn {
        display: inline-block;
        background: var(--accent);
        color: #fff;
        border: 2.5px solid var(--ink);
        border-radius: 16px;
        padding: 13px 38px;
        font-size: 1.08rem;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 5px 0 var(--ink);
        transition: transform 0.08s, box-shadow 0.08s;
        font-family: inherit;
      }
      .btn:active:not(:disabled) {
        transform: translateY(4px);
        box-shadow: 0 1px 0 var(--ink);
      }
      .btn:disabled {
        cursor: wait;
      }
      .cat-btn {
        background: #fff;
        border: 2px solid var(--ink);
        border-radius: 999px;
        padding: 7px 15px;
        margin: 0 6px 8px 0;
        font-size: 0.88rem;
        font-weight: 800;
        color: var(--text);
        cursor: pointer;
        box-shadow: 2px 2px 0 var(--shadow);
        font-family: inherit;
      }
      .cat-btn.active {
        background: var(--ink);
        border-color: var(--ink);
        color: #fff;
        box-shadow: 2px 2px 0 rgba(58, 46, 40, 0.25);
      }
      /* 히어로 */
      .hero {
        text-align: center;
        padding: 26px 0 6px;
        position: relative;
      }
      .hero h1 {
        font-size: 2.15rem;
        line-height: 1.25;
        font-weight: 900;
        letter-spacing: -0.03em;
        margin: 14px 0 8px;
      }
      .marker {
        background: linear-gradient(transparent 52%, var(--sun) 52% 94%, transparent 94%);
        padding: 0 4px;
      }
      .sticker {
        display: inline-block;
        background: #fff;
        border: 2px solid var(--ink);
        border-radius: 999px;
        padding: 6px 16px;
        font-weight: 900;
        font-size: 0.9rem;
        box-shadow: 3px 3px 0 var(--ink);
        animation: floaty 2.6s ease-in-out infinite;
      }
      .hero .float-emoji {
        position: absolute;
        font-size: 1.9rem;
        animation: floaty 3.2s ease-in-out infinite;
        user-select: none;
      }
      @keyframes floaty {
        0%,
        100% {
          transform: translateY(0) rotate(-4deg);
        }
        50% {
          transform: translateY(-9px) rotate(4deg);
        }
      }
      .section-title {
        font-size: 1.25rem;
        font-weight: 900;
        letter-spacing: -0.02em;
        margin: 0 0 4px;
      }
      /* 영수증 결과지 */
      .receipt {
        background: #fff;
        border: 2.5px solid var(--ink);
        border-radius: 18px;
        padding: 20px 18px 16px;
        box-shadow: 5px 5px 0 var(--ink);
        max-width: 340px;
        margin: 4px auto 0;
      }
      .receipt .stamp {
        display: inline-block;
        background: var(--sun);
        border: 2px solid var(--ink);
        border-radius: 10px;
        padding: 1px 12px;
        font-weight: 900;
        font-size: 0.8rem;
        transform: rotate(-3deg);
        letter-spacing: 0.08em;
      }
      .receipt-name {
        font-size: 1.55rem;
        font-weight: 900;
        letter-spacing: -0.02em;
        margin: 10px 0 2px;
      }
      .receipt-meta {
        color: var(--muted);
        font-size: 0.88rem;
        font-weight: 700;
      }
      .receipt-dash {
        border-top: 2px dashed #d8c3a5;
        margin: 12px 0;
      }
      .receipt-link {
        display: inline-block;
        background: var(--ink);
        color: #fff !important;
        font-weight: 900;
        border-radius: 12px;
        padding: 9px 22px;
        text-decoration: none;
        margin-top: 2px;
      }
      .receipt-foot {
        margin-top: 10px;
        font-size: 0.8rem;
        color: var(--muted);
        font-weight: 700;
      }
      article.recipe-body img {
        max-width: 100%;
        border-radius: 12px;
      }
      article.recipe-body h2 {
        margin-top: 2em;
        font-size: 1.25rem;
      }
      article.recipe-body li {
        margin-bottom: 6px;
      }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="logo" href="/">🍚 <b>돌려밥</b></a>
        <nav class="site">
          <a href="/">홈</a>
          <a href="/roulette/">돌림판</a>
          <a href="/pick/">뽑기3종</a>
          <a href="/recipes/">레시피</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="wrap">
        <p>
          <a href="/about/">소개</a>
          <a href="/privacy/">개인정보처리방침</a>
          <a href="/terms/">이용약관</a>
          <a href="/contact/">문의하기</a>
        </p>
        <p>© 2026 돌려밥. 직접 해먹은 경험만 기록합니다.</p>
        <!-- TODO: 운영자 이메일 확정 후 contact 페이지와 함께 교체 -->
      </div>
    </footer>
  </body>
</html>
