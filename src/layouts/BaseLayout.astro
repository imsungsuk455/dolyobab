---
const PUB_ID = "ca-pub-3484572882367046"; // 본인 AdSense 게시자 ID

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canon = Astro.url.href;
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canon} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canon} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="google-adsense-account" content={PUB_ID} />
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${PUB_ID}`}
      crossorigin="anonymous"
    ></script>
    <style>
      :root {
        --accent: #e8590c;
        --bg: #fff9f2;
        --text: #343a40;
        --muted: #868e96;
        --card: #ffffff;
        --line: #f1e4d4;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: -apple-system, "Pretendard", "Apple SD Gothic Neo",
          "Noto Sans KR", sans-serif;
        line-height: 1.7;
      }
      .wrap {
        max-width: 720px;
        margin: 0 auto;
        padding: 0 20px;
      }
      header.site {
        background: #fff;
        border-bottom: 1px solid var(--line);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      header.site .wrap {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 60px;
      }
      .logo {
        font-size: 1.3rem;
        font-weight: 900;
        color: var(--accent);
        text-decoration: none;
      }
      nav.site a {
        margin-left: 16px;
        color: var(--text);
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 600;
      }
      nav.site a:hover {
        color: var(--accent);
      }
      main {
        padding: 32px 0 56px;
      }
      footer.site {
        border-top: 1px solid var(--line);
        background: #fff;
        padding: 28px 0 40px;
        font-size: 0.85rem;
        color: var(--muted);
      }
      footer.site a {
        color: var(--muted);
        text-decoration: none;
        margin-right: 14px;
      }
      .card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 22px;
        margin: 18px 0;
      }
      .btn {
        display: inline-block;
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: 999px;
        padding: 14px 36px;
        font-size: 1.05rem;
        font-weight: 800;
        cursor: pointer;
      }
      .btn:active {
        transform: scale(0.97);
      }
      .cat-btn {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 8px 16px;
        margin: 0 6px 8px 0;
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--text);
        cursor: pointer;
      }
      .cat-btn.active {
        background: var(--accent);
        border-color: var(--accent);
        color: #fff;
      }
      article.recipe-body img {
        max-width: 100%;
        border-radius: 12px;
      }
      article.recipe-body h2 {
        margin-top: 2em;
        font-size: 1.25rem;
      }
      article.recipe-body li {
        margin-bottom: 6px;
      }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="logo" href="/">🍚 돌려밥</a>
        <nav class="site">
          <a href="/">홈</a>
          <a href="/roulette/">돌림판</a>
          <a href="/pick/">골라먹기</a>
          <a href="/recipes/">레시피</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="wrap">
        <p>
          <a href="/about/">소개</a>
          <a href="/privacy/">개인정보처리방침</a>
          <a href="/terms/">이용약관</a>
          <a href="/contact/">문의하기</a>
        </p>
        <p>© 2026 돌려밥. 직접 해먹은 경험만 기록합니다.</p>
        <!-- TODO: 운영자 이메일 확정 후 contact 페이지와 함께 교체 -->
      </div>
    </footer>
  </body>
</html>
