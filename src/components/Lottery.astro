---
import menus from "../data/menus.json";
---

<div class="card" id="lotto-box" style="text-align: center;">
  <p style="color: var(--muted); font-size: 0.9rem; margin-top: 0;">
    공 6개 중 행운의 한 개가 뽑힙니다
  </p>
  <div
    id="lotto-machine"
    style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin: 18px 0; min-height: 76px;"
  ></div>
  <div>
    <button class="btn" id="lotto-draw">🎰 로또 뽑기</button>
  </div>
  <div style="margin-top: 10px;">
    <button class="cat-btn" id="lotto-reshuffle">🔀 공 다시 섞기</button>
  </div>
  <div id="lotto-result" style="margin-top: 14px; min-height: 80px;">
    <p style="color: var(--muted);">버튼을 누르면 공이 튑니다</p>
  </div>
</div>

<style>
  .lotto-ball {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 900;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
    box-shadow: inset -4px -6px 0 rgba(0, 0, 0, 0.18), 0 4px 10px rgba(0, 0, 0, 0.15);
    transition: transform 0.25s, opacity 0.25s, box-shadow 0.25s;
  }
  #lotto-machine.shaking .lotto-ball {
    animation: ball-bounce 0.45s ease-in-out infinite alternate;
  }
  #lotto-machine.shaking .lotto-ball:nth-child(2n) {
    animation-delay: 0.1s;
  }
  #lotto-machine.shaking .lotto-ball:nth-child(3n) {
    animation-delay: 0.2s;
  }
  @keyframes ball-bounce {
    from {
      transform: translateY(0) scale(1);
    }
    to {
      transform: translateY(-16px) scale(1.06);
    }
  }
  .lotto-ball.dim {
    opacity: 0.35;
    transform: scale(0.85);
  }
  .lotto-ball.winner {
    transform: scale(1.3);
    box-shadow: inset -4px -6px 0 rgba(0, 0, 0, 0.18), 0 0 0 4px #ffd43b,
      0 8px 22px rgba(232, 89, 12, 0.45);
  }
</style>

<script type="application/json" id="lotto-data" set:html={JSON.stringify(menus)} />

<script is:inline>
  (function () {
    var box = document.getElementById("lotto-box");
    if (!box) return;
    var MENUS = JSON.parse(document.getElementById("lotto-data").textContent);
    var BALL_COLORS = ["#f59f00", "#4dabf7", "#ff6b6b", "#9775fa", "#63e6be", "#e8590c"];

    var machine = document.getElementById("lotto-machine");
    var resultEl = document.getElementById("lotto-result");
    var drawBtn = document.getElementById("lotto-draw");
    var balls = [];
    var drawing = false;

    function esc(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
      });
    }

    function shuffle(a) {
      for (var i = a.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = a[i];
        a[i] = a[j];
        a[j] = t;
      }
      return a;
    }

    function setup() {
      balls = shuffle(MENUS.slice()).slice(0, 6);
      machine.classList.remove("shaking");
      machine.innerHTML = "";
      balls.forEach(function (m, i) {
        var b = document.createElement("div");
        b.className = "lotto-ball";
        b.style.background = BALL_COLORS[i % BALL_COLORS.length];
        b.textContent = i + 1;
        b.title = m.name;
        machine.appendChild(b);
      });
      resultEl.innerHTML = '<p style="color: var(--muted);">버튼을 누르면 공이 튑니다</p>';
    }

    function draw() {
      if (drawing) return;
      drawing = true;
      drawBtn.disabled = true;
      drawBtn.style.opacity = "0.6";
      var kids = machine.children;
      for (var i = 0; i < kids.length; i++) {
        kids[i].classList.remove("winner", "dim");
      }
      machine.classList.add("shaking");
      resultEl.innerHTML = '<p style="color:var(--muted);font-weight:800;">두구두구두구…</p>';

      setTimeout(function () {
        machine.classList.remove("shaking");
        var wi = Math.floor(Math.random() * balls.length);
        for (var k = 0; k < kids.length; k++) {
          kids[k].classList.add(k === wi ? "winner" : "dim");
        }
        var item = balls[wi];
        var link = item.slug
          ? '<p style="margin-top:8px;"><a href="/recipes/' +
            esc(item.slug) +
            '/" style="color:var(--accent);font-weight:800;">👉 ' +
            esc(item.name) +
            " 레시피 보기</a></p>"
          : "";
        resultEl.innerHTML =
          '<div style="font-size:1.4rem;font-weight:900;">🎱 ' +
          (wi + 1) +
          "번 공: " +
          esc(item.name) +
          "</div>" +
          '<div style="color:var(--muted);font-size:0.9rem;">' +
          esc(item.category) +
          " · " +
          esc(item.time) +
          "</div>" +
          link;
        drawing = false;
        drawBtn.disabled = false;
        drawBtn.style.opacity = "1";
      }, 2200);
    }

    drawBtn.addEventListener("click", draw);
    document.getElementById("lotto-reshuffle").addEventListener("click", function () {
      if (drawing) return;
      setup();
    });

    setup();
  })();
</script>
