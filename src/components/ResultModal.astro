<div
  id="doly-modal"
  style="display:none; position:fixed; inset:0; z-index:100; align-items:center; justify-content:center; padding:20px; background:rgba(58,46,40,0.55);"
>
  <div
    id="doly-modal-card"
    style="background:#fff; border:2.5px solid var(--ink); border-radius:22px; box-shadow:6px 6px 0 var(--ink); max-width:360px; width:100%; overflow:hidden; text-align:center; transform:scale(0.9); opacity:0; transition:transform .45s cubic-bezier(.16,1,.3,1), opacity .3s;"
  >
    <div style="position:relative; background:#fff3e6;">
      <img
        id="doly-modal-img"
        src=""
        alt=""
        style="display:none; width:100%; height:230px; object-fit:cover;"
      />
      <div id="doly-modal-emoji" style="font-size:4rem; padding:30px 0 10px;">🍽️</div>
      <button
        id="doly-modal-close"
        aria-label="닫기"
        style="position:absolute; top:10px; right:10px; width:34px; height:34px; border-radius:50%; border:2px solid var(--ink); background:#fff; font-size:.95rem; font-weight:900; cursor:pointer;"
      >
        ✕
      </button>
    </div>
    <div style="padding:8px 20px 20px;">
      <span id="doly-modal-stamp" class="stamp">돌려밥 주문서</span>
      <div id="doly-modal-name" class="receipt-name"></div>
      <div id="doly-modal-meta" class="receipt-meta"></div>
      <div class="receipt-dash"></div>
      <div id="doly-modal-action"></div>
      <div style="margin-top:12px;">
        <button class="cat-btn" id="doly-modal-retry" style="margin:0;">🎡 다시 돌리기</button>
      </div>
      <div class="receipt-foot">맛있게 드세요! 😋</div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    if (window.DolyModal) return;
    var modal = document.getElementById("doly-modal");
    var card = document.getElementById("doly-modal-card");

    function close() {
      card.style.transform = "scale(0.9)";
      card.style.opacity = "0";
      setTimeout(function () {
        modal.style.display = "none";
      }, 250);
    }

    document.getElementById("doly-modal-close").addEventListener("click", close);
    modal.addEventListener("click", function (e) {
      if (e.target === modal) close();
    });
    document.getElementById("doly-modal-retry").addEventListener("click", function () {
      close();
      if (window.__dolyRetry) setTimeout(window.__dolyRetry, 260);
    });

    window.DolyModal = {
      show: function (item, opts) {
        opts = opts || {};
        var img = document.getElementById("doly-modal-img");
        var emo = document.getElementById("doly-modal-emoji");
        if (item.image) {
          img.src = item.image;
          img.alt = item.name;
          img.style.display = "block";
          emo.style.display = "none";
        } else {
          img.removeAttribute("src");
          img.style.display = "none";
          emo.style.display = "block";
        }
        document.getElementById("doly-modal-stamp").textContent =
          opts.stamp || "돌려밥 주문서";
        document.getElementById("doly-modal-name").textContent = item.name;
        document.getElementById("doly-modal-meta").textContent = item.custom
          ? "내가 추가한 메뉴"
          : (item.category || "") +
            " · " +
            (item.time || "-") +
            " · 난이도 " +
            (item.difficulty || "-");
        var act = document.getElementById("doly-modal-action");
        if (item.slug) {
          act.innerHTML =
            '<a class="receipt-link" href="/recipes/' + item.slug + '/">👉 레시피 보기</a>';
        } else if (item.custom) {
          act.innerHTML =
            '<div style="color:var(--muted);font-size:0.9rem;font-weight:700;">내 메뉴라 레시피는 없어요. 맛있게 드세요!</div>';
        } else {
          act.innerHTML =
            '<div style="color:var(--muted);font-size:0.9rem;font-weight:700;">레시피 준비 중 — 그래도 오늘은 이거다!</div>';
        }
        document.getElementById("doly-modal-retry").style.display = window.__dolyRetry
          ? "inline-block"
          : "none";
        modal.style.display = "flex";
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            card.style.transform = "scale(1)";
            card.style.opacity = "1";
          });
        });
      },
    };
  })();
</script>