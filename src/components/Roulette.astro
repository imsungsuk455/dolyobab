---
import menus from "../data/menus.json";

const categories = ["전체", ...Array.from(new Set(menus.map((m) => m.category)))];
---

<div class="card lift reveal" id="roulette-box" style="text-align: center;">
  <div style="display:flex;justify-content:flex-end;">
    <button class="sound-toggle" data-sound title="소리 켜기/끄기">🔊</button>
  </div>
  <div id="roulette-cats" style="margin-bottom: 8px;">
    {
      categories.map((c, i) => (
        <button class:list={["cat-btn", { active: i === 0 }]} data-cat={c}>
          {c}
        </button>
      ))
    }
  </div>

  <div id="wheel-wrap" style="position: relative; width: 100%; max-width: 340px; margin: 8px auto 0;">
    <div
      id="wheel-pointer"
      style="position: absolute; top: -6px; left: 50%; transform: translateX(-50%); width: 0; height: 0; border-left: 13px solid transparent; border-right: 13px solid transparent; border-top: 22px solid #3A2E28; z-index: 2;"
    ></div>
    <canvas
      id="dolly-wheel"
      width="400"
      height="400"
      style="width: 100%; max-width: 400px; height: auto; cursor: pointer; filter: drop-shadow(0 10px 22px rgba(232,89,12,.25));"
    ></canvas>
  </div>

  <div style="margin-top: 16px;">
    <button class="btn btn-big" id="roulette-spin">🎡 돌리기</button>
  </div>

  <div style="margin-top: 12px;">
    <button class="cat-btn" id="custom-toggle" style="margin: 0;">＋ 내 메뉴 추가</button>
  </div>
  <div id="custom-panel" style="display: none; margin-top: 10px;">
    <div style="display: flex; gap: 8px; justify-content: center;">
      <input
        id="custom-input"
        maxlength="10"
        placeholder="예: 김치찜"
        style="width: 150px; border: 2px solid var(--ink); border-radius: 12px; padding: 8px 12px; font-size: 0.9rem; font-weight: 700; font-family: inherit; outline: none;"
      />
      <button class="cat-btn" id="custom-add" style="margin: 0;">추가</button>
    </div>
    <div id="custom-chips" style="margin-top: 10px;"></div>
  </div>

  <div id="roulette-result" style="margin-top: 18px; min-height: 90px;">
    <p style="color: var(--muted);">원판을 눌러도 돌아갑니다</p>
  </div>
</div>

<div
  id="roulette-modal"
  style="display: none; position: fixed; inset: 0; z-index: 100; align-items: center; justify-content: center; padding: 20px; background: rgba(58, 46, 40, 0.55);"
>
  <div
    id="roulette-modal-card"
    style="background: #fff; border: 2.5px solid var(--ink); border-radius: 22px; box-shadow: 6px 6px 0 var(--ink); max-width: 360px; width: 100%; overflow: hidden; text-align: center; transform: scale(0.9); opacity: 0; transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s;"
  >
    <div style="position: relative; background: #fff3e6;">
      <img
        id="roulette-modal-img"
        src=""
        alt=""
        style="display: none; width: 100%; height: 230px; object-fit: cover;"
      />
      <div id="roulette-modal-emoji" style="font-size: 4rem; padding: 30px 0 10px;">🍽️</div>
      <button
        id="roulette-modal-close"
        aria-label="닫기"
        style="position: absolute; top: 10px; right: 10px; width: 34px; height: 34px; border-radius: 50%; border: 2px solid var(--ink); background: #fff; font-size: 0.95rem; font-weight: 900; cursor: pointer;"
      >
        ✕
      </button>
    </div>
    <div style="padding: 8px 20px 20px;">
      <span class="stamp">돌려밥 주문서</span>
      <div id="roulette-modal-name" class="receipt-name"></div>
      <div id="roulette-modal-meta" class="receipt-meta"></div>
      <div class="receipt-dash"></div>
      <div id="roulette-modal-action"></div>
      <div style="margin-top: 12px;">
        <button class="cat-btn" id="roulette-modal-retry" style="margin: 0;">🎡 다시 돌리기</button>
      </div>
      <div class="receipt-foot">맛있게 드세요! 😋</div>
    </div>
  </div>
</div>

<script type="application/json" id="roulette-data" set:html={JSON.stringify(menus)} />

<script is:inline>
  (function () {
    var box = document.getElementById("roulette-box");
    if (!box) return;

    var MENUS = JSON.parse(document.getElementById("roulette-data").textContent);
    var COLORS = ["#FF4D2E", "#FF9F1C", "#FFC53D", "#2FBFA0", "#4D96FF", "#9B5DE5", "#F15BB5", "#00B8C4"];
    var WHEEL_SIZE = 8;

    var activeCat = "전체";
    var wheelItems = [];
    var rotation = 0;
    var spinning = false;

    var canvas = document.getElementById("dolly-wheel");
    var ctx = canvas.getContext("2d");
    var resultEl = document.getElementById("roulette-result");
    var spinBtn = document.getElementById("roulette-spin");

    // 효과음 (WebAudio, 외부 파일 없음)
    var AC = null;
    function soundEnabled() {
      try {
        return localStorage.getItem("doly-sound") !== "off";
      } catch (e) {
        return true;
      }
    }
    function ac() {
      if (!AC) {
        try {
          AC = new (window.AudioContext || window.webkitAudioContext)();
        } catch (e) {}
      }
      if (AC && AC.state === "suspended") AC.resume();
      return AC;
    }
    function beep(freq, dur, type, vol, when) {
      if (!soundEnabled()) return;
      var c = ac();
      if (!c) return;
      try {
        var t = c.currentTime + (when || 0);
        var o = c.createOscillator();
        var g = c.createGain();
        o.type = type || "triangle";
        o.frequency.value = freq;
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(vol || 0.15, t + 0.01);
        g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
        o.connect(g);
        g.connect(c.destination);
        o.start(t);
        o.stop(t + dur + 0.02);
      } catch (e) {}
    }
    function tick() {
      beep(2200, 0.03, "square", 0.05);
    }
    function fanfare() {
      var notes = [523.25, 659.25, 783.99, 1046.5];
      for (var i = 0; i < notes.length; i++) {
        beep(notes[i], 0.14, "triangle", 0.16, i * 0.11);
      }
    }
    function syncSoundIcons() {
      var off = !soundEnabled();
      document.querySelectorAll("[data-sound]").forEach(function (b) {
        b.textContent = off ? "🔇" : "🔊";
      });
    }
    syncSoundIcons();
    document.querySelectorAll("[data-sound]").forEach(function (b) {
      b.addEventListener("click", function () {
        try {
          localStorage.setItem("doly-sound", soundEnabled() ? "off" : "on");
        } catch (e) {}
        syncSoundIcons();
      });
    });

    // 선명한 원판을 위해 DPR 대응
    var dpr = window.devicePixelRatio || 1;
    var SIZE = 400;
    canvas.width = SIZE * dpr;
    canvas.height = SIZE * dpr;
    ctx.scale(dpr, dpr);

    function esc(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
      });
    }

    function pool() {
      var base = MENUS.filter(function (m) {
        return activeCat === "전체" || m.category === activeCat;
      });
      var mine = mineItems();
      if (activeCat === "전체") return base.concat(mine);
      if (activeCat === "내 메뉴") return mine;
      return base;
    }

    // 내 메뉴 ( localStorage 저장, 최대 12개 )
    var customs = [];
    try {
      customs = JSON.parse(localStorage.getItem("doly-custom") || "[]");
    } catch (e) {
      customs = [];
    }
    if (!Array.isArray(customs)) customs = [];
    function saveCustoms() {
      try {
        localStorage.setItem("doly-custom", JSON.stringify(customs.slice(0, 12)));
      } catch (e) {}
    }
    function mineItems() {
      return customs.map(function (n) {
        return {
          name: n,
          category: "내 메뉴",
          situations: [],
          time: "-",
          difficulty: "-",
          slug: null,
          image: null,
          custom: true,
        };
      });
    }

    // 결과 모달 (음식 사진 크게)
    var modal = document.getElementById("roulette-modal");
    var modalCard = document.getElementById("roulette-modal-card");
    function openModal(item) {
      var img = document.getElementById("roulette-modal-img");
      var emo = document.getElementById("roulette-modal-emoji");
      if (item.image) {
        img.src = item.image;
        img.alt = item.name;
        img.style.display = "block";
        emo.style.display = "none";
      } else {
        img.removeAttribute("src");
        img.style.display = "none";
        emo.style.display = "block";
      }
      document.getElementById("roulette-modal-name").textContent = item.name;
      document.getElementById("roulette-modal-meta").textContent = item.custom
        ? "내가 추가한 메뉴"
        : item.category + " · " + item.time + " · 난이도 " + item.difficulty;
      var act = document.getElementById("roulette-modal-action");
      if (item.slug) {
        act.innerHTML =
          '<a class="receipt-link" href="/recipes/' + esc(item.slug) + '/">👉 레시피 보기</a>';
      } else if (item.custom) {
        act.innerHTML =
          '<div style="color:var(--muted);font-size:0.9rem;font-weight:700;">내 메뉴라 레시피는 없어요. 맛있게 드세요!</div>';
      } else {
        act.innerHTML =
          '<div style="color:var(--muted);font-size:0.9rem;font-weight:700;">레시피 준비 중 — 그래도 오늘은 이거다!</div>';
      }
      modal.style.display = "flex";
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          modalCard.style.transform = "scale(1)";
          modalCard.style.opacity = "1";
        });
      });
    }
    function closeModal() {
      modalCard.style.transform = "scale(0.9)";
      modalCard.style.opacity = "0";
      setTimeout(function () {
        modal.style.display = "none";
      }, 250);
    }

    // 원판에 올릴 최대 8개 후보 선정
    function buildWheel() {
      var p = pool().slice();
      for (var i = p.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = p[i];
        p[i] = p[j];
        p[j] = t;
      }
      wheelItems = p.slice(0, WHEEL_SIZE);
      rotation = 0;
      drawWheel();
    }

    function drawWheel() {
      var cx = SIZE / 2;
      var cy = SIZE / 2;
      var r = SIZE / 2 - 4;
      ctx.clearRect(0, 0, SIZE, SIZE);
      var n = wheelItems.length;
      if (n === 0) return;
      var seg = (Math.PI * 2) / n;

      for (var i = 0; i < n; i++) {
        var a0 = rotation + i * seg;
        var a1 = a0 + seg;
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.arc(cx, cy, r, a0, a1);
        ctx.closePath();
        ctx.fillStyle = COLORS[i % COLORS.length];
        ctx.fill();
        ctx.strokeStyle = "#ffffff";
        ctx.lineWidth = 3;
        ctx.stroke();

        // 라벨
        ctx.save();
        ctx.translate(cx, cy);
        ctx.rotate(a0 + seg / 2);
        ctx.textAlign = "right";
        ctx.fillStyle = "#ffffff";
        ctx.font = "800 15px -apple-system, 'Pretendard', sans-serif";
        ctx.shadowColor = "rgba(0,0,0,.25)";
        ctx.shadowBlur = 3;
        var label = wheelItems[i].name;
        if (label.length > 7) label = label.slice(0, 7) + "…";
        ctx.fillText(label, r - 16, 5);
        ctx.restore();
      }

      // 중앙 허브
      ctx.beginPath();
      ctx.arc(cx, cy, 50, 0, Math.PI * 2);
      ctx.fillStyle = "#3A2E28";
      ctx.fill();
      ctx.fillStyle = "#FFC53D";
      ctx.font = "900 19px -apple-system, 'Pretendard', sans-serif";
      ctx.textAlign = "center";
      ctx.fillText("돌려밥", cx, cy + 6);
    }

    function receiptHTML(icon, name, meta, slug) {
      var action = slug
        ? '<a class="receipt-link" href="/recipes/' +
          esc(slug) +
          '/">👉 레시피 보기</a>'
        : '<div style="color:var(--muted);font-size:0.9rem;font-weight:700;">레시피 준비 중 — 그래도 오늘은 이거다!</div>';
      return (
        '<div class="receipt">' +
        '<span class="stamp">돌려밥 주문서</span>' +
        '<div class="receipt-name">' +
        icon +
        " " +
        esc(name) +
        "</div>" +
        '<div class="receipt-meta">' +
        meta +
        "</div>" +
        '<div class="receipt-dash"></div>' +
        action +
        '<div class="receipt-foot">맛있게 드세요! 😋</div>' +
        "</div>"
      );
    }

    function showResult(item) {
      resultEl.innerHTML = receiptHTML(
        "🍽️",
        item.name,
        esc(item.category) + " · " + esc(item.time) + " · 난이도 " + esc(item.difficulty),
        item.slug
      );
      openModal(item);
    }

    function confetti() {
      var c = document.createElement("canvas");
      c.style.cssText =
        "position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:9999;";
      document.body.appendChild(c);
      var x = c.getContext("2d");
      c.width = window.innerWidth;
      c.height = window.innerHeight;
      var parts = [];
      for (var i = 0; i < 90; i++) {
        parts.push({
          x: window.innerWidth / 2 + (Math.random() - 0.5) * 200,
          y: window.innerHeight / 2,
          vx: (Math.random() - 0.5) * 14,
          vy: -Math.random() * 12 - 3,
          s: Math.random() * 7 + 3,
          col: COLORS[i % COLORS.length],
          rot: Math.random() * Math.PI,
        });
      }
      var frames = 0;
      (function tick() {
        x.clearRect(0, 0, c.width, c.height);
        parts.forEach(function (p) {
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.45;
          p.rot += 0.15;
          x.save();
          x.translate(p.x, p.y);
          x.rotate(p.rot);
          x.fillStyle = p.col;
          x.fillRect(-p.s / 2, -p.s / 2, p.s, p.s * 0.6);
          x.restore();
        });
        if (++frames < 90) requestAnimationFrame(tick);
        else c.remove();
      })();
    }

    function spin() {
      if (spinning) return;
      if (wheelItems.length === 0) return;
      if (wheelItems.length === 1) {
        showResult(wheelItems[0]);
        confetti();
        return;
      }
      spinning = true;
      spinBtn.disabled = true;
      spinBtn.style.opacity = "0.6";

      var n = wheelItems.length;
      var seg = (Math.PI * 2) / n;
      var winner = Math.floor(Math.random() * n);
      // 포인터(위쪽, -90°)에 당첨 칸 중심이 오도록 목표 회전각 계산
      var target = -Math.PI / 2 - (winner + 0.5) * seg;
      var turns = Math.PI * 2 * (5 + Math.floor(Math.random() * 3));
      var start = rotation;
      // 현재 각도에서 앞으로만 돌도록 보정
      var delta = ((target - start) % (Math.PI * 2) + Math.PI * 2) % (Math.PI * 2) + turns;

      var dur = 4200;
      var t0 = null;
      var lastSeg = -1;
      function frame(t) {
        if (!t0) t0 = t;
        var p = Math.min((t - t0) / dur, 1);
        var eased = 1 - Math.pow(1 - p, 4);
        rotation = start + delta * eased;
        var norm = ((rotation % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2);
        var segNow = Math.floor(norm / seg);
        if (segNow !== lastSeg) {
          lastSeg = segNow;
          tick();
        }
        drawWheel();
        if (p < 1) {
          requestAnimationFrame(frame);
        } else {
          rotation = start + delta;
          drawWheel();
          spinning = false;
          spinBtn.disabled = false;
          spinBtn.style.opacity = "1";
          showResult(wheelItems[winner]);
          fanfare();
          confetti();
        }
      }
      requestAnimationFrame(frame);
    }

    function onCatClick(b) {
      if (spinning) return;
      box
        .querySelectorAll("#roulette-cats .cat-btn")
        .forEach(function (x) { x.classList.remove("active"); });
      b.classList.add("active");
      activeCat = b.getAttribute("data-cat");
      resultEl.innerHTML =
        '<p style="color: var(--muted);">후보가 바뀌었습니다. 돌려보세요!</p>';
      buildWheel();
    }
    function ensureMineChip() {
      var wrap = document.getElementById("roulette-cats");
      var exists = wrap.querySelector('[data-cat="내 메뉴"]');
      if (customs.length === 0) {
        if (exists) {
          if (activeCat === "내 메뉴") {
            activeCat = "전체";
            var first = wrap.querySelector(".cat-btn");
            if (first) first.classList.add("active");
          }
          exists.remove();
        }
        return;
      }
      if (!exists) {
        var nb = document.createElement("button");
        nb.className = "cat-btn";
        nb.setAttribute("data-cat", "내 메뉴");
        nb.textContent = "내 메뉴";
        nb.addEventListener("click", function () {
          onCatClick(nb);
        });
        wrap.appendChild(nb);
      }
    }
    function renderCustomChips() {
      var cc = document.getElementById("custom-chips");
      cc.innerHTML = "";
      customs.forEach(function (n) {
        var s = document.createElement("span");
        s.style.cssText =
          "display:inline-block;background:#fff;border:2px solid var(--ink);border-radius:999px;padding:4px 8px 4px 12px;margin:0 6px 6px 0;font-size:.85rem;font-weight:800;";
        s.textContent = n + " ";
        var x = document.createElement("button");
        x.textContent = "✕";
        x.setAttribute("aria-label", n + " 삭제");
        x.style.cssText =
          "border:none;background:var(--sun);border-radius:50%;width:20px;height:20px;font-size:.7rem;font-weight:900;cursor:pointer;margin-left:4px;font-family:inherit;";
        x.addEventListener("click", function () {
          customs = customs.filter(function (c) {
            return c !== n;
          });
          saveCustoms();
          renderCustomChips();
          ensureMineChip();
          buildWheel();
        });
        s.appendChild(x);
        cc.appendChild(s);
      });
    }
    function addCustom() {
      var inp = document.getElementById("custom-input");
      var v = inp.value.trim().replace(/\s+/g, " ");
      if (!v) return;
      if (v.length > 10) {
        inp.value = v.slice(0, 10);
        return;
      }
      if (customs.indexOf(v) !== -1) {
        inp.value = "";
        inp.placeholder = "이미 있어요!";
        return;
      }
      if (customs.length >= 12) {
        inp.placeholder = "최대 12개까지!";
        return;
      }
      customs.push(v);
      inp.value = "";
      inp.placeholder = "예: 김치찜";
      saveCustoms();
      renderCustomChips();
      ensureMineChip();
      buildWheel();
    }

    box.querySelectorAll("#roulette-cats .cat-btn").forEach(function (b) {
      b.addEventListener("click", function () {
        onCatClick(b);
      });
    });

    document.getElementById("custom-toggle").addEventListener("click", function () {
      var p = document.getElementById("custom-panel");
      p.style.display = p.style.display === "none" ? "block" : "none";
    });
    document.getElementById("custom-add").addEventListener("click", addCustom);
    document.getElementById("custom-input").addEventListener("keydown", function (e) {
      if (e.key === "Enter") addCustom();
    });
    document.getElementById("roulette-modal-close").addEventListener("click", closeModal);
    modal.addEventListener("click", function (e) {
      if (e.target === modal) closeModal();
    });
    document.getElementById("roulette-modal-retry").addEventListener("click", function () {
      closeModal();
      setTimeout(spin, 260);
    });

    renderCustomChips();
    ensureMineChip();
    spinBtn.addEventListener("click", spin);
    canvas.addEventListener("click", spin);
    buildWheel();
  })();
</script>
