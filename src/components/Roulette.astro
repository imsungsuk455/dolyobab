---
import menus from "../data/menus.json";
import CustomPanel from "../components/CustomPanel.astro";

const categories = ["전체", ...Array.from(new Set(menus.map((m) => m.category)))];
---

<div class="card lift reveal" id="roulette-box" style="text-align: center;">
  <div style="display:flex;justify-content:flex-end;">
    <button class="sound-toggle" data-sound title="소리 켜기/끄기">🔊</button>
  </div>
  <div id="roulette-cats" style="margin-bottom: 8px;">
    {
      categories.map((c, i) => (
        <button class:list={["cat-btn", { active: i === 0 }]} data-cat={c}>
          {c}
        </button>
      ))
    }
  </div>

  <div id="wheel-wrap" style="position: relative; width: 100%; max-width: 340px; margin: 8px auto 0;">
    <div
      id="wheel-pointer"
      style="position: absolute; top: -6px; left: 50%; transform: translateX(-50%); width: 0; height: 0; border-left: 13px solid transparent; border-right: 13px solid transparent; border-top: 22px solid #3A2E28; z-index: 2;"
    ></div>
    <canvas
      id="dolly-wheel"
      width="400"
      height="400"
      style="width: 100%; max-width: 400px; height: auto; cursor: pointer; filter: drop-shadow(0 10px 22px rgba(232,89,12,.25));"
    ></canvas>
  </div>

  <div style="margin-top: 16px;">
    <button class="btn btn-big" id="roulette-spin">🎡 돌리기</button>
  </div>

  <CustomPanel />

  <div id="roulette-result" style="margin-top: 18px; min-height: 90px;">
    <p style="color: var(--muted);">원판을 눌러도 돌아갑니다</p>
  </div>
</div>

<script type="application/json" id="roulette-data" set:html={JSON.stringify(menus)} />

<script is:inline>
  (function () {
    var box = document.getElementById("roulette-box");
    if (!box) return;

    var MENUS = JSON.parse(document.getElementById("roulette-data").textContent);
    var COLORS = ["#FF4D2E", "#FF9F1C", "#FFC53D", "#2FBFA0", "#4D96FF", "#9B5DE5", "#F15BB5", "#00B8C4"];
    var WHEEL_SIZE = 8;

    var activeCat = "전체";
    var wheelItems = [];
    var rotation = 0;
    var spinning = false;

    var canvas = document.getElementById("dolly-wheel");
    var ctx = canvas.getContext("2d");
    var resultEl = document.getElementById("roulette-result");
    var spinBtn = document.getElementById("roulette-spin");

    function getAllCustoms() {
      return window.DolyCustom ? window.DolyCustom.getAll() : [];
    }
    function mineItems() {
      return getAllCustoms().map(function (n) {
        return { name: n, category: "내 메뉴", situations: [], time: "-", difficulty: "-", slug: null, image: null, custom: true };
      });
    }

    // 효과음
    var AC = null;
    function soundEnabled() {
      try {
        return localStorage.getItem("doly-sound") !== "off";
      } catch (e) {
        return true;
      }
    }
    function ac() {
      if (!AC) {
        try {
          AC = new (window.AudioContext || window.webkitAudioContext)();
        } catch (e) {}
      }
      if (AC && AC.state === "suspended") AC.resume();
      return AC;
    }
    function beep(freq, dur, type, vol, when) {
      if (!soundEnabled()) return;
      var c = ac();
      if (!c) return;
      try {
        var t = c.currentTime + (when || 0);
        var o = c.createOscillator();
        var g = c.createGain();
        o.type = type || "triangle";
        o.frequency.value = freq;
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(vol || 0.15, t + 0.01);
        g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
        o.connect(g);
        g.connect(c.destination);
        o.start(t);
        o.stop(t + dur + 0.02);
      } catch (e) {}
    }
    function tick() {
      beep(2200, 0.03, "square", 0.05);
    }
    function fanfare() {
      var notes = [523.25, 659.25, 783.99, 1046.5];
      for (var i = 0; i < notes.length; i++) {
        beep(notes[i], 0.14, "triangle", 0.16, i * 0.11);
      }
    }
    function syncSoundIcons() {
      var off = !soundEnabled();
      document.querySelectorAll("[data-sound]").forEach(function (b) {
        b.textContent = off ? "🔇" : "🔊";
      });
    }
    syncSoundIcons();
    document.querySelectorAll("[data-sound]").forEach(function (b) {
      b.addEventListener("click", function () {
        try {
          localStorage.setItem("doly-sound", soundEnabled() ? "off" : "on");
        } catch (e) {}
        syncSoundIcons();
      });
    });

    var dpr = window.devicePixelRatio || 1;
    var SIZE = 400;
    canvas.width = SIZE * dpr;
    canvas.height = SIZE * dpr;
    ctx.scale(dpr, dpr);

    function esc(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
      });
    }

    function pool() {
      var base = MENUS.filter(function (m) {
        return activeCat === "전체" || m.category === activeCat;
      });
      var mine = mineItems();
      if (activeCat === "전체") return base.concat(mine);
      if (activeCat === "내 메뉴") return mine;
      return base;
    }

    function buildWheel() {
      var p = pool().slice();
      for (var i = p.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = p[i];
        p[i] = p[j];
        p[j] = t;
      }
      wheelItems = p.slice(0, WHEEL_SIZE);
      rotation = 0;
      drawWheel();
    }

    function drawWheel() {
      var cx = SIZE / 2;
      var cy = SIZE / 2;
      var r = SIZE / 2 - 4;
      ctx.clearRect(0, 0, SIZE, SIZE);
      var n = wheelItems.length;
      if (n === 0) return;
      var seg = (Math.PI * 2) / n;

      for (var i = 0; i < n; i++) {
        var a0 = rotation + i * seg;
        var a1 = a0 + seg;
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.arc(cx, cy, r, a0, a1);
        ctx.closePath();
        ctx.fillStyle = COLORS[i % COLORS.length];
        ctx.fill();
        ctx.strokeStyle = "#ffffff";
        ctx.lineWidth = 3;
        ctx.stroke();

        ctx.save();
        ctx.translate(cx, cy);
        ctx.rotate(a0 + seg / 2);
        ctx.textAlign = "right";
        ctx.fillStyle = "#ffffff";
        ctx.font = "800 15px -apple-system, 'Pretendard', sans-serif";
        ctx.shadowColor = "rgba(0,0,0,.25)";
        ctx.shadowBlur = 3;
        var label = wheelItems[i].name;
        if (label.length > 7) label = label.slice(0, 7) + "…";
        ctx.fillText(label, r - 16, 5);
        ctx.restore();
      }

      ctx.beginPath();
      ctx.arc(cx, cy, 50, 0, Math.PI * 2);
      ctx.fillStyle = "#3A2E28";
      ctx.fill();
      ctx.fillStyle = "#FFC53D";
      ctx.font = "900 19px -apple-system, 'Pretendard', sans-serif";
      ctx.textAlign = "center";
      ctx.fillText("돌려밥", cx, cy + 6);
    }

    function receiptHTML(icon, name, meta, slug) {
      var action = slug
        ? '<a class="receipt-link" href="/recipes/' +
          esc(slug) +
          '/">👉 레시피 보기</a>'
        : '<div style="color:var(--muted);font-size:0.9rem;font-weight:700;">레시피 준비 중 — 그래도 오늘은 이거다!</div>';
      return (
        '<div class="receipt">' +
        '<span class="stamp">돌려밥 주문서</span>' +
        '<div class="receipt-name">' +
        icon +
        " " +
        esc(name) +
        "</div>" +
        '<div class="receipt-meta">' +
        meta +
        "</div>" +
        '<div class="receipt-dash"></div>' +
        action +
        '<div class="receipt-foot">맛있게 드세요! 😋</div>' +
        "</div>"
      );
    }

    function showResult(item) {
      resultEl.innerHTML = receiptHTML(
        "🍽️",
        item.name,
        esc(item.category) + " · " + esc(item.time) + " · 난이도 " + esc(item.difficulty),
        item.slug
      );
      window.__dolyRetry = spin;
      window.DolyModal.show(item, { stamp: "돌려밥 주문서" });
    }

    function confetti() {
      var c = document.createElement("canvas");
      c.style.cssText =
        "position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:9999;";
      document.body.appendChild(c);
      var x = c.getContext("2d");
      c.width = window.innerWidth;
      c.height = window.innerHeight;
      var parts = [];
      for (var i = 0; i < 90; i++) {
        parts.push({
          x: window.innerWidth / 2 + (Math.random() - 0.5) * 200,
          y: window.innerHeight / 2,
          vx: (Math.random() - 0.5) * 14,
          vy: -Math.random() * 12 - 3,
          s: Math.random() * 7 + 3,
          col: COLORS[i % COLORS.length],
          rot: Math.random() * Math.PI,
        });
      }
      var frames = 0;
      (function tick() {
        x.clearRect(0, 0, c.width, c.height);
        parts.forEach(function (p) {
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.45;
          p.rot += 0.15;
          x.save();
          x.translate(p.x, p.y);
          x.rotate(p.rot);
          x.fillStyle = p.col;
          x.fillRect(-p.s / 2, -p.s / 2, p.s, p.s * 0.6);
          x.restore();
        });
        if (++frames < 90) requestAnimationFrame(tick);
        else c.remove();
      })();
    }

    function spin() {
      if (spinning) return;
      if (wheelItems.length === 0) return;
      if (wheelItems.length === 1) {
        showResult(wheelItems[0]);
        confetti();
        return;
      }
      spinning = true;
      spinBtn.disabled = true;
      spinBtn.style.opacity = "0.6";

      var n = wheelItems.length;
      var seg = (Math.PI * 2) / n;
      var winner = Math.floor(Math.random() * n);
      var target = -Math.PI / 2 - (winner + 0.5) * seg;
      var turns = Math.PI * 2 * (5 + Math.floor(Math.random() * 3));
      var start = rotation;
      var delta = ((target - start) % (Math.PI * 2) + Math.PI * 2) % (Math.PI * 2) + turns;

      var dur = 4200;
      var t0 = null;
      var lastSeg = -1;
      function frame(t) {
        if (!t0) t0 = t;
        var p = Math.min((t - t0) / dur, 1);
        var eased = 1 - Math.pow(1 - p, 4);
        rotation = start + delta * eased;
        var norm = ((rotation % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2);
        var segNow = Math.floor(norm / seg);
        if (segNow !== lastSeg) {
          lastSeg = segNow;
          tick();
        }
        drawWheel();
        if (p < 1) {
          requestAnimationFrame(frame);
        } else {
          rotation = start + delta;
          drawWheel();
          spinning = false;
          spinBtn.disabled = false;
          spinBtn.style.opacity = "1";
          showResult(wheelItems[winner]);
          fanfare();
          confetti();
        }
      }
      requestAnimationFrame(frame);
    }

    function onCatClick(b) {
      if (spinning) return;
      box
        .querySelectorAll("#roulette-cats .cat-btn")
        .forEach(function (x) { x.classList.remove("active"); });
      b.classList.add("active");
      activeCat = b.getAttribute("data-cat");
      resultEl.innerHTML =
        '<p style="color: var(--muted);">후보가 바뀌었습니다. 돌려보세요!</p>';
      buildWheel();
    }

    function ensureMineChip() {
      var wrap = document.getElementById("roulette-cats");
      var exists = wrap.querySelector('[data-cat="내 메뉴"]');
      if (getAllCustoms().length === 0) {
        if (exists) {
          if (activeCat === "내 메뉴") {
            activeCat = "전체";
            var first = wrap.querySelector(".cat-btn");
            if (first) first.classList.add("active");
          }
          exists.remove();
        }
        return;
      }
      if (!exists) {
        var nb = document.createElement("button");
        nb.className = "cat-btn";
        nb.setAttribute("data-cat", "내 메뉴");
        nb.textContent = "내 메뉴";
        nb.addEventListener("click", function () {
          onCatClick(nb);
        });
        wrap.appendChild(nb);
      }
    }

    box.querySelectorAll("#roulette-cats .cat-btn").forEach(function (b) {
      b.addEventListener("click", function () {
        onCatClick(b);
      });
    });

    window.addEventListener("doly-custom-changed", function () {
      ensureMineChip();
      buildWheel();
    });

    ensureMineChip();
    spinBtn.addEventListener("click", spin);
    canvas.addEventListener("click", spin);
    buildWheel();
  })();
</script>