---
import menus from "../data/menus.json";

const situations = Array.from(new Set(menus.flatMap((m) => m.situations)));
---

<div class="card" id="sitpick-box" style="text-align: center;">
  <div id="sitpick-chips" style="margin-bottom: 14px;">
    {
      situations.map((s) => (
        <button class="cat-btn" data-sit={s}>
          {s}
        </button>
      ))
    }
  </div>
  <button class="btn" id="sitpick-spin">🎲 이 상황에 맞는 메뉴 뽑기</button>
  <div id="sitpick-result" style="margin-top: 18px; min-height: 90px;">
    <p style="color: var(--muted);">지금 기분에 맞는 상황을 하나 고르세요</p>
  </div>
</div>

<script type="application/json" id="sitpick-data" set:html={JSON.stringify(menus)} />

<script is:inline>
  (function () {
    var box = document.getElementById("sitpick-box");
    if (!box) return;
    var MENUS = JSON.parse(document.getElementById("sitpick-data").textContent);
    var selected = "";
    var lastName = "";
    var resultEl = document.getElementById("sitpick-result");

    function esc(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
      });
    }

    box.querySelectorAll("#sitpick-chips .cat-btn").forEach(function (b) {
      b.addEventListener("click", function () {
        box
          .querySelectorAll("#sitpick-chips .cat-btn")
          .forEach(function (x) { x.classList.remove("active"); });
        b.classList.add("active");
        selected = b.getAttribute("data-sit");
      });
    });

    document.getElementById("sitpick-spin").addEventListener("click", function () {
      if (!selected) {
        resultEl.innerHTML =
          '<p style="color:var(--accent);font-weight:800;">먼저 상황을 하나 골라주세요 👆</p>';
        return;
      }
      var pool = MENUS.filter(function (m) {
        return m.situations.indexOf(selected) !== -1;
      });
      if (pool.length > 1 && lastName) {
        pool = pool.filter(function (m) { return m.name !== lastName; });
      }
      var pick = pool[Math.floor(Math.random() * pool.length)];
      lastName = pick.name;
      var link = pick.slug
        ? '<p style="margin-top:10px;"><a href="/recipes/' +
          esc(pick.slug) +
          '/" style="color:var(--accent);font-weight:800;">👉 ' +
          esc(pick.name) +
          " 레시피 보기</a></p>"
        : '<p style="margin-top:10px;color:var(--muted);font-size:0.9rem;">레시피 준비 중 — 그래도 오늘은 이거다!</p>';
      resultEl.innerHTML =
        '<div style="font-size:2rem;">🎯</div>' +
        '<div style="font-size:1.4rem;font-weight:900;">' +
        esc(pick.name) +
        "</div>" +
        '<div style="color:var(--muted);font-size:0.9rem;">#' +
        esc(selected) +
        " · " +
        esc(pick.category) +
        " · " +
        esc(pick.time) +
        "</div>" +
        link;
    });
  })();
</script>
